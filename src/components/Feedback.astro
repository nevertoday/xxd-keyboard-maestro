---
// 每页末尾一行：这一页没看懂、照做不成，就到 GitHub 提出来（带好页面信息的模板），或者先翻常见问题。
// 不放个人联系方式：学的人在 GitHub 上提问、讨论，大家都看得到，答案也能补进教程。
import { link, langOf, fullLang, REPO } from "../data/nav.js";
import { X as dict } from "../i18n/index.js";
interface Props { page: string }
const lang = langOf(Astro.url.pathname);
const x = dict(lang);
const en = lang !== "zh";
const site = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const url = site + Astro.url.pathname;
const T = en
  ? {
      title: `[Feedback] ${Astro.props.page}`,
      body: `Page: ${url}\n\nWhat was unclear / what didn't work:\n\nmacOS version (Apple menu > About This Mac, e.g. macOS 26.1):\n\nKeyboard Maestro version (Keyboard Maestro > About Keyboard Maestro, e.g. 11.1.1):\n\nWhat the macro should do:\n\nWhat happened instead (paste any error or Engine log line; no license details, passwords or personal text):\n\nWhat you tried:\n`,
      lead: "Something on this page unclear, or didn't work as written?",
      gh: "Bring it up on GitHub",
      faq: [". Or check the ", "FAQ", " first."],
    }
  : {
      title: `[教程反馈] ${Astro.props.page}`,
      body: `页面：${url}\n\n哪里没看懂 / 照做不成功：\n\nmacOS 版本（苹果菜单 > 关于本机，比如 macOS 26.1）：\n\nKeyboard Maestro 版本（Keyboard Maestro > About Keyboard Maestro，比如 11.1.1）：\n\n这个宏应该做什么：\n\n实际发生了什么（有报错或引擎日志就直接复制文字；别贴许可证信息、密码和个人文字）：\n\n试过什么：\n`,
      lead: "这一页有没看懂、或者照做不成的地方？",
      gh: "到 GitHub 提出来",
      faq: ["，也可以先翻翻", "常见问题", "。"],
    };
// 以后加的语言：反馈的 issue 模板用英文（维护者看得懂），页面上的文字用这种语言
if (x) Object.assign(T, x.comp.feedback);
// 中文、日文：问号后面直接接，不空格
const sp = /^(zh|ja)$/.test(lang) ? "" : " ";
const href = `${REPO}/issues/new?title=${encodeURIComponent(T.title)}&body=${encodeURIComponent(T.body)}`;
---
<aside class="feedback">
  <i data-xxd-icon="MessagesSquare" data-size="16"></i>
  <span>{T.lead}{sp}<a class="xxd-link" href={href} rel="noopener">{T.gh}</a>{T.faq[0]}<a class="xxd-link" href={link("/faq/", fullLang(lang))}>{T.faq[1]}</a>{T.faq[2]}</span>
</aside>
