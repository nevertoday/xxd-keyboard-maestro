---
// 示意 Keyboard Maestro 弹出来的东西大概长什么样（Display Text 的窗口、通知、报错提示）：不是复制用的，标题写明「示意」。正文里用 ①②③ 标出要看的地方，下面再逐条解释。
import { langOf } from "../data/nav.js";
import { X as dict, fmt } from "../i18n/index.js";
interface Props { title?: string; code: string }
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const { title = dict(lang) ? dict(lang).comp.reply : en ? "Illustration: roughly what Keyboard Maestro shows" : "示意：Keyboard Maestro 里大概是这样", code } = Astro.props;
---
<figure class="xxd-code-block reply-demo">
  <figcaption class="xxd-code__head">{title}</figcaption>
  <pre class="xxd-code" tabindex="0"><code data-lang="text">{code}</code></pre>
</figure>
