---
// 首页：先对新手说话（你是不是也这样 → 新手三课），再给想用得更深的人几条路进完整教程（TRACKS），最后是适不适合、提问和讨论。
// 中文、英文的文字在下面的 ZH、EN；以后加的语言在 src/i18n/<语言>.js 的 home（结构照 base.js），完整教程链到英文页。
// 完整教程还没写好的步骤（nav.js 里 ready: false）不给链接，和左侧导航一样显示「编写中」。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { LESSONS, lessonHref, STEPS, stepHref, link, langOf, fullLang, t } from "../data/nav.js";
import { X as dict, fmt } from "../i18n/index.js";

const lang = langOf(Astro.url.pathname);
const fl = fullLang(lang);
const hl = fl === lang ? undefined : fl;

const ZH = {
  brand: "Keyboard Maestro 新手教程",
  h1: "把你在 Mac 上天天重复的那几下，交给 Keyboard Maestro",
  lead: ["Keyboard Maestro 是 Stairways Software 做的 Mac 自动化工具。你告诉它「什么时候」和「做什么」：按下某个键，就打开某个 App；打出几个字母，就换成一整段话。说好了，它就在后台替你做，每次都一样。这个网站讲给从没做过自动化的人，也讲给已经在用、想用得更深的人。", "这是非官方学习站", "，和 Stairways Software 没有关系；功能和用法以官方 Wiki 为准。"],
  cta: ["新手从第 1 课开始", "已经在用了？看 How-to"],
  ctaNote: "第 1 课做一个按键打开 App 的宏，第 2 课打几个字出一整段话，第 3 课一个键做完开工那一串事。不用写代码。",
  painH: "你是不是也这样",
  PAIN: [
    "给家长、客人或同事回消息，「收到，谢谢，我这周五前答复你」这句话，一天要一个字一个字打好几遍。",
    "每天开工，先点开邮件、日历和同一个网页，再把窗口一个个拖回老地方，然后才开始干活。",
    "有个菜单命令天天要用，偏偏没有快捷键，每次都得拿鼠标一层层去找。",
    "投简历、发报价，每次都从上一封里复制同一段自我介绍、同一份联系方式。",
    "复制了一段要紧的字，转头又复制了别的，前面那段就找不回来了。",
    "每天晚上同一个时间，要打开同一个表格记下爸妈今天的血压，忙起来就忘了。",
  ],
  lessonsH: "新手只要三课",
  lessonsP: "按顺序看，一课十几分钟，跟着做就行。学完这三课，你就会自己做宏了；网站上别的内容，遇到了再查。",
  lessonsLabel: "新手入门：共 3 课",
  tracksH: "用熟以后看这里",
  tracksP: "做过几个宏以后，你会想让它做更多的事。完整教程按顺序分成 8 步，大致是三条路，挑你眼下用得上的那条看。",
  // TRACKS：[图标, 标题, 说明, 对应的完整教程步骤]
  TRACKS: [
    ["Zap", "宏是怎么转起来的", "宏组管宏在哪里生效，触发器管什么时候开始，动作管做什么。把这三样弄懂，大多数宏你都能自己搭出来。", [0, 1, 2, 3]],
    ["GitBranch", "让宏看情况办事", "记住一段字，先问你一句，看情况走不同的路，等某件事发生再往下；复制过的东西也都找得回来。", [4, 5]],
    ["Wrench", "不灵的时候，和再往深走", "宏不灵时先查权限和引擎，再一步一步看它卡在哪；用顺了，接上脚本，两台 Mac 用同一套宏，把宏分享给别人。", [6, 7]],
  ],
  tracksLabel: "完整教程里对应的步骤",
  stepLink: (n: number, title: string) => `第 ${n} 步：${title}`,
  pending: "编写中",
  fitH: "适不适合你", yesH: "适合", noH: "先不用",
  YES: [
    "你在 Mac 上有一件事每天要做好几遍，想把它交出去",
    "你不会写代码：新手三课一行代码也不用写",
    "你愿意花几分钟给它开辅助功能这类系统权限，它要替你按键、选菜单、挪窗口",
    "你想先试再决定：它是付费软件，官网有全功能的试用版",
  ],
  NO: [
    "你用的不是 Mac：它只有 Mac 版，要 macOS 10.13 或更新",
    "你不想给任何 App 开系统权限：没有这些权限，大部分宏都跑不起来",
    "这件事只做一次：手动做一遍更快",
  ],
};

const EN: typeof ZH = {
  brand: "Keyboard Maestro for beginners",
  h1: "Hand the things you repeat on your Mac every day to Keyboard Maestro",
  lead: ["Keyboard Maestro is a Mac automation app from Stairways Software. You tell it when and what: press this key and open that app, type these few letters and swap in a whole paragraph. Once you've told it, it does the job in the background, the same way every time. This site is for people who have never automated anything, and for people who already use it and want to go further. ", "This is an unofficial guide", ", not affiliated with Stairways Software. For features and how they work, the official wiki is the source of truth."],
  cta: ["New? Start with lesson 1", "Already using it? The how-tos"],
  ctaNote: "Lesson 1 builds a key that opens an app, lesson 2 turns a few letters into a whole paragraph, and lesson 3 makes one key run your start-of-day routine. No code needed.",
  painH: "Sound familiar?",
  PAIN: [
    "Answering parents, customers or colleagues, you type \"Got it, thanks, I'll get back to you by Friday\" letter by letter several times a day.",
    "Every morning you open Mail, Calendar and the same web page, then drag each window back where it belongs before you can start.",
    "There's a menu command you use every day that has no shortcut, so every time you go hunting for it with the mouse.",
    "Every job application or quote means copying the same intro and the same contact details out of the last one.",
    "You copy something important, then copy something else, and the first thing is gone for good.",
    "Every evening at the same time you're meant to open the same spreadsheet and log your parents' blood pressure, and on busy days you forget.",
  ],
  lessonsH: "Beginners need just three lessons",
  lessonsP: "Read them in order. Each takes ten or fifteen minutes and you build as you go. After these three you can make your own macros, and everything else on the site is there to look up when you need it.",
  lessonsLabel: "Beginner track: 3 lessons",
  tracksH: "Once you're comfortable",
  tracksP: "After a few macros you'll want it to do more. The full guide runs in 8 steps, roughly along three tracks. Start with whichever one you need right now.",
  TRACKS: [
    ["Zap", "How a macro runs", "Macro groups decide where a macro works, triggers decide when it starts, and actions say what it does. Understand those three and you can build most macros yourself.", [0, 1, 2, 3]],
    ["GitBranch", "Macros that adapt", "Remember some text, ask you a question, take a different path depending on what's happening, wait for something before carrying on. And get back anything you've copied.", [4, 5]],
    ["Wrench", "When it misfires, and going further", "When a macro doesn't work, check permissions and the Engine first, then step through to see where it gets stuck. Later, hook in scripts, use the same macros on two Macs, and share macros with others.", [6, 7]],
  ],
  tracksLabel: "Matching steps in the full guide",
  stepLink: (n, title) => `Step ${n}: ${title}`,
  pending: "In progress",
  fitH: "Is it for you?", yesH: "Yes, if", noH: "Not yet, if",
  YES: [
    "There's something you do on your Mac several times a day and you'd like to hand it off",
    "You don't write code. The three beginner lessons don't need a single line",
    "You're willing to spend a few minutes granting it system permissions like Accessibility, since it presses keys, chooses menus and moves windows for you",
    "You want to try before you decide. It's paid software, and the official site has a fully working trial",
  ],
  NO: [
    "You're not on a Mac. It's Mac only and needs macOS 10.13 or later",
    "You don't want to give any app system permissions. Without them, most macros can't run",
    "It's a one-off job. Doing it once by hand is quicker",
  ],
};

// 以后加的语言：文字来自 src/i18n/<语言>.js 的 home（缺的键是 base.js 的英文）；TRACKS 的图标和步骤沿用这里
const x = dict(lang);
const C: typeof ZH = x
  ? { ...EN, ...x.home, brand: x.ui.brand,
      TRACKS: EN.TRACKS.map(([icon, , , steps], i) => [icon, ...(x.home.TRACKS?.[i] ?? EN.TRACKS[i].slice(1, 3)), steps]),
      stepLink: (n: number, title: string) => fmt(x.home.stepLink, { n, title }) }
  : lang === "en" ? EN : ZH;
const headings = [["h-pain", C.painH], ["h-lessons", C.lessonsH], ["h-tracks", C.tracksH], ["h-fit", C.fitH]].map(([slug, text]) => ({ slug, text, depth: 2 }));
---
<Site title={C.brand} headings={headings}>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={lessonHref(LESSONS[0], lang)}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={link("/howto/", fl)} hreflang={hl}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((p) => <li>{p}</li>)}</ul>
    </section>

    <section aria-labelledby="h-lessons">
      <h2 id="h-lessons">{C.lessonsH}</h2>
      <p>{C.lessonsP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.lessonsLabel}>
        {LESSONS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={lessonHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-tracks">
      <h2 id="h-tracks">{C.tracksH}</h2>
      <p>{C.tracksP}</p>
      {x && <p class="home__note">{x.home.devNote}</p>}
      <div class="flow">
        {C.TRACKS.map(([icon, h, p, steps]) => (
          <div class="flow__box">
            <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
            <p class="flow__title">{h}</p>
            <p class="flow__desc">{p}</p>
            <ul class="flow__how" aria-label={C.tracksLabel}>
              {(steps as number[]).map((n) => STEPS.find((s) => s.n === n)!).map((s) => (
                <li>{s.ready
                  ? <a href={stepHref(s, fl)} hreflang={hl}>{C.stepLink(s.n, t(s, "title", fl))}</a>
                  : <>{C.stepLink(s.n, t(s, "title", fl))}<span class="xxd-badge roadmap__pending">{C.pending}</span></>}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((y) => <li>{y}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((y) => <li>{y}</li>)}</ul></div>
      </div>
    </section>

    <Contact />
  </div>
</Site>
