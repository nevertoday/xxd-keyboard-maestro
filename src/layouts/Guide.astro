---
// 主线教程的一步：进度、标题、预计时间，正文，上一步 / 下一步
import Site from "./Site.astro";
import Feedback from "../components/Feedback.astro";
import { STEPS, stepHref, langOf, t } from "../data/nav.js";
import { ui } from "../data/ui.js";
import { fmt } from "../l10n/load.js";
const { frontmatter, headings = [] } = Astro.props;
const lang = langOf(Astro.url.pathname);
const i = STEPS.findIndex((s) => s.n === frontmatter.step);
const s = STEPS[i], prev = STEPS[i - 1], next = STEPS[i + 1];
const last = STEPS[STEPS.length - 1].n;
const title = t(s, "title", lang);
const U = ui(lang).guide;
const T = { head: fmt(U.head, { n: s.n, title }), eyebrow: fmt(U.eyebrow, { n: s.n, last }), prog: fmt(U.prog, { n: s.n, last }) };
// 反馈 issue 的标题：中文、英文照页面写；另外 8 种语言用英文标题，前面标上语言（维护者看得懂）
const page = lang === "zh" ? `第 ${s.n} 步 ${title}` : lang === "en" ? `Step ${s.n} ${title}` : `[${lang}] Step ${s.n} ${t(s, "title", "en")}`;
---
<Site title={T.head} description={frontmatter.description ?? t(s, "sum", lang)} headings={headings}>
  <header class="step-head">
    <div class="step-head__eyebrow"><span>{T.eyebrow}</span><span>{t(s, "minutes", lang)}</span></div>
    <progress class="xxd-progress" value={s.n} max={last} aria-label={T.prog}></progress>
    <h1>{title}</h1>
    {frontmatter.tldr && <p class="page-tldr"><span class="page-tldr__label">{U.tldr}</span>{frontmatter.tldr}</p>}
    <div class="step-head__meta">
      {frontmatter.need && <span class="xxd-badge">{U.need}{frontmatter.need}</span>}
    </div>
  </header>
  <article class="xxd-prose"><slot /></article>
  <Feedback page={page} />
  <nav class="prevnext" aria-label={U.nav}>
    {prev && (prev.ready
      ? <a href={stepHref(prev, lang)} data-dir="prev"><small>{U.prev}</small>{prev.n}. {t(prev, "title", lang)}</a>
      : <span data-dir="prev"><small>{U.prev}</small>{prev.n}. {t(prev, "title", lang)}</span>)}
    {next && (next.ready
      ? <a href={stepHref(next, lang)} data-dir="next"><small>{U.next}</small>{next.n}. {t(next, "title", lang)}</a>
      : <span data-dir="next"><small>{U.pending}</small>{next.n}. {t(next, "title", lang)}</span>)}
  </nav>
</Site>
