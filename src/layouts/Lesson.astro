---
// 新手入门的一课：第几课、预计时间、正文，上一课 / 下一课。最后一课的「下一步」指回首页的「接下来」。
import Site from "./Site.astro";
import Feedback from "../components/Feedback.astro";
import { LESSONS, lessonHref, langOf, t } from "../data/nav.js";
import { ui } from "../data/ui.js";
import { fmt } from "../l10n/load.js";
const { frontmatter, headings = [] } = Astro.props;
const lang = langOf(Astro.url.pathname);
const i = LESSONS.findIndex((s) => s.n === frontmatter.lesson);
const s = LESSONS[i], prev = LESSONS[i - 1], next = LESSONS[i + 1];
const total = LESSONS.length;
const title = t(s, "title", lang);
const U = ui(lang).lesson;
const T = { eyebrow: fmt(U.eyebrow, { n: s.n, total }), prog: fmt(U.prog, { n: s.n, total }), title: fmt(U.title, { n: s.n, title }) };
// 反馈 issue 的标题：中文、英文照页面写；另外 8 种语言用英文课名，前面标上语言（维护者看得懂）
const page = lang === "zh" ? `第 ${s.n} 课 ${title}` : lang === "en" ? `Lesson ${s.n} ${title}` : `[${lang}] Lesson ${s.n} ${t(s, "title", "en")}`;
---
<Site title={T.title} description={frontmatter.description ?? t(s, "sum", lang)} headings={headings}>
  <header class="step-head">
    <div class="step-head__eyebrow"><span>{T.eyebrow}</span><span>{t(s, "minutes", lang)}</span></div>
    <progress class="xxd-progress" value={s.n} max={total} aria-label={T.prog}></progress>
    <h1>{title}</h1>
    {frontmatter.tldr && <p class="page-tldr"><span class="page-tldr__label">{U.tldr}</span>{frontmatter.tldr}</p>}
  </header>
  <article class="xxd-prose"><slot /></article>
  <Feedback page={page} />
  <nav class="prevnext" aria-label={U.nav}>
    {prev && <a href={lessonHref(prev, lang)} data-dir="prev"><small>{U.prev}</small>{prev.n}. {t(prev, "title", lang)}</a>}
    {next && <a href={lessonHref(next, lang)} data-dir="next"><small>{U.next}</small>{next.n}. {t(next, "title", lang)}</a>}
  </nav>
</Site>
